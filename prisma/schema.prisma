  accuracy      Float
  value         Float
  location      Float
  cleanliness   Float
  checkIn       Float
  communication Float
  amenities     Int[]
  onMap         String        @db.VarChar(1020)
  createdAt     DateTime      @db.Timestamptz(6)
  updatedAt     DateTime      @db.Timestamptz(6)
  DestinationId Int?
